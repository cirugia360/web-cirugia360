{
  "functions": {
    "api/blog-page.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "crons": [
    {
      "path": "/api/cirugia360-speed/queue-dispatch",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-page?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
